{
  "schemaVersion": 1,
  "id": "rpgdifficulty",
  "version": "${version}",
  "name": "RpgDifficulty",
  "description": "Changes the strength of mobs over time/distance in your world",
  "authors": [
    "Globox_Z"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/rpgdifficulty",
    "sources": "https://github.com/Globox1997/RpgDifficulty",
    "issues": "https://github.com/Globox1997/RpgDifficulty/issues"
  },
  "license": "MIT",
  "icon": "assets/rpgdifficulty/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rpgdifficulty.fabric.RpgDifficultyFabric"
    ],
    "client": [
      "net.rpgdifficulty.fabric.client.RpgDifficultyFabricClient"
    ],
    "modmenu": [
      "net.rpgdifficulty.fabric.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "rpgdifficulty.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}"
  }
}
